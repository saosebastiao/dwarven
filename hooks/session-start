#!/usr/bin/env bash
# SessionStart hook for dwarven plugin (Claude Code)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_dwarven_content=$(cat "${PLUGIN_ROOT}/skills/using-dwarven/SKILL.md" 2>&1 || echo "Error reading using-dwarven skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_dwarven_escaped=$(escape_for_json "$using_dwarven_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have dwarven.\n\n**Below is the full content of your 'dwarven:using-dwarven' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_dwarven_escaped}\n</EXTREMELY_IMPORTANT>"

# Claude Code expects hookSpecificOutput.additionalContext.
# printf instead of heredoc to avoid a bash 5.3+ heredoc hang.
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
