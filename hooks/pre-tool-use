#!/usr/bin/env bash
# PreToolUse hook for dwarven plugin (Claude Code).
#
# Defense-in-depth on R6.5 universal never-list. .claude/settings.json
# is the primary enforcement (project-wide deny patterns); this hook
# is a backstop that runs even if settings are bypassed.
#
# Limitations:
# - Substring matching may produce false positives (e.g., a commit
#   message containing "git reset --hard"). Maintainer can rephrase.
# - Per-agent enforcement (e.g., "shell can't mutate", "Implementation
#   can't push to main") is not implemented here; subagent context
#   detection requires further work and is targeted for a follow-up.
# - Fail-open: any script error or parse failure defaults to allow
#   (no decision), so a buggy hook never breaks the workflow.

set -uo pipefail

INPUT="$(cat)"

# Extract tool_name; fall through if parse fails.
TOOL_NAME=""
TOOL_NAME=$(printf '%s' "$INPUT" | sed -n 's/.*"tool_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1) || true

# Only Bash invocations carry the patterns we deny.
if [[ "$TOOL_NAME" != "Bash" ]]; then
    exit 0
fi

# Extract command from tool_input.command; fall through if missing.
COMMAND=""
COMMAND=$(printf '%s' "$INPUT" | sed -n 's/.*"command":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1) || true

if [[ -z "$COMMAND" ]]; then
    exit 0
fi

# Universal deny patterns (R6.5 of docs/specs/dwarven.md).
DENY_PATTERNS=(
    "git push --force"
    "git push -f"
    "git reset --hard"
    "git checkout -- ."
    "git restore ."
    "git clean -f"
    "rm -rf"
    "gh repo create"
    "gh repo delete"
    "gh repo edit"
    "gh repo archive"
    "gh release delete"
)

for pattern in "${DENY_PATTERNS[@]}"; do
    if [[ "$COMMAND" == *"$pattern"* ]]; then
        printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PreToolUse",\n    "permissionDecision": "deny",\n    "permissionDecisionReason": "Denied by Dwarven plugin: matches universal never-list pattern (R6.5 of docs/specs/dwarven.md): %s"\n  }\n}\n' "$pattern"
        exit 0
    fi
done

# No match — fall through (allow).
exit 0
